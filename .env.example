PORT=3000
AUTH_USERNAME=admin
AUTH_PASSWORD=change-this-password

# Optional: GitHub personal access token for public API requests.
# Helps avoid the unauthenticated API request limit.
GITHUB_TOKEN=

# Optional: Discord project settings synchronization
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=

# Required for Discord snapshot synchronization. Generate with:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
DISCORD_SYNC_ENCRYPTION_KEY=
